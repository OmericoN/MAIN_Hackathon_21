# PostgreSQL connection used by Supabase CLI or trusted backend database clients.
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@HOST:5432/postgres"

# Supabase API configuration used by FastAPI.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="replace-with-publishable-key"
SUPABASE_SECRET_KEY="replace-with-secret-key"

FRONTEND_ORIGIN="http://127.0.0.1:5173,http://localhost:5173"
